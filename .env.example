# Where contact form messages are delivered (required for email to work).
MAIL_TO=you@example.com

# Option A (works on Render's free plan): Resend HTTP API, https://resend.com
# Without a verified domain, Resend only delivers to your own account's address.
RESEND_API_KEY=
# MAIL_FROM=Radionica Radonić <kontakt@your-domain.com>

# Option B (paid hosting only on Render, which blocks SMTP on free instances)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
